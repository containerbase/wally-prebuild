{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>containerbase/.github", "github>containerbase/.github//merge-queue.json"],
  "packageRules": [
    {
      "description": "Enable minor updates on renovate rebuild trigger file",
      "matchFileNames": ["renovate.Dockerfile"],
      "matchUpdateTypes": ["minor"],
      "enabled": true
    },
    {
      "description": "extract wally version",
      "matchPackageNames": ["UpliftGames/wally"],
      "matchDatasources": ["github-releases"],
      "extractVersion": "v(?<version>.+)"
    },
    {
      "description": "Keep containerbase v14 while we build jammy, v15 doesn't install there",
      "matchPackageNames": ["ghcr.io/containerbase/base"],
      "allowedVersions": "<15"
    }
  ]
}
